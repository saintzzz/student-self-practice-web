<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.vieschool.gtm-inbox</string>
  <key>ProgramArguments</key><array>
    <string>/usr/local/bin/node</string>
    <string>scripts/gtm/inbox.mjs</string>
  </array>
  <key>WorkingDirectory</key><string>REPO_PATH</string>
  <key>StartInterval</key><integer>900</integer>
  <key>StandardOutPath</key><string>REPO_PATH/logs/gtm-inbox.log</string>
  <key>StandardErrorPath</key><string>REPO_PATH/logs/gtm-inbox.log</string>
</dict></plist>
